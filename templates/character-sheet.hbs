<form class="mezoria-creation" autocomplete="off">
 {{#if error}}
  <p class="mezoria-warning">{{error}}</p>
 {{else}}
 <header class="mezoria-header">
  <div class="mezoria-headline">
   <div><h2>MEZORIA · Character</h2></div>
   {{#if creatorOpen}}
    <button type="button" class="mezoria-back-button" data-close-creator>Back to Sheet</button>
   {{else}}
    <button type="button" class="mezoria-create-button" data-open-creator title="Open Character Creator" aria-label="Open Character Creator">+</button>
   {{/if}}
  </div>
  <div class="mezoria-identity">
   <label>Name <input type="text" value="{{headerName}}" readonly></label>
   <label>Rank <input type="text" value="1 · Quartz" readonly></label>
   <label>Race <input type="text" value="{{headerRace}}" readonly></label>
   {{#if showSubgroup}}<label>{{subgroupType}} <input type="text" value="{{headerSubgroup}}" readonly></label>{{/if}}
   <label>Background <input type="text" value="{{headerBackground}}" readonly></label>
   <label>Mark of Purpose <input type="text" value="{{headerMark}}" readonly></label>
  </div>
  <div class="mezoria-header-operations" aria-label="Character resources and actions">
   <div class="mezoria-header-essence">
    <label>Current Essence <input type="number" min="0" step="1" data-essence-field="currentEssence" value="{{currentEssence}}"></label>
    <label>Spent Essence <input type="number" min="0" step="1" data-essence-field="spentEssence" value="{{spentEssence}}"></label>
   </div>
   {{#unless creatorOpen}}
   <div class="mezoria-header-actions">
    <button type="button" data-resource-recovery="turn" {{#unless creationComplete}}disabled title="Finish character creation first"{{else}}title="End turn: restore 1 LifeForce and 1 Mana at Quartz rank"{{/unless}}>End Turn</button>
    <button type="button" data-resource-recovery="light" {{#unless creationComplete}}disabled title="Finish character creation before resting"{{else}}title="4-hour light rest: restore 50% of maximum LifeForce and Mana"{{/unless}}>Light Rest · 4h</button>
    <button type="button" data-resource-recovery="full" {{#unless creationComplete}}disabled title="Finish character creation before resting"{{else}}title="8-hour full rest: fully restore LifeForce and Mana and recover 1 Wound"{{/unless}}>Full Rest · 8h</button>
    <button type="button" data-roll-action-score {{#unless creationComplete}}disabled title="Finish character creation to roll Action Score"{{else}}title="Add d20 and Prowess tens to current Action Score"{{/unless}}>Roll Action Score</button>
    <button type="button" disabled title="Essence spending menu is planned for a later update">Spend Essence (Soon)</button>
   </div>
   {{/unless}}
  </div>
 </header>

 {{#if creatorOpen}}
 <nav class="mezoria-tabs mezoria-creation-tabs" aria-label="Character creation steps">
  {{#each steps}}<button type="button" data-step="{{key}}" class="{{#if active}}active{{/if}}">{{title}}</button>{{/each}}
 </nav>
 <section class="mezoria-wizard">
  {{#if stepRace}}
   <h3>1 · Select Race</h3>
   <label>Race <select data-field="race">{{#each raceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{#if showSubgroup}}
    <label>{{subgroupType}} <select data-field="subgroup"><option value="">Choose…</option>{{#each subgroupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{/if}}
   {{#if raceBonusPending}}<p class="mezoria-selection-hint">Choose a race to apply its attribute adjustments.</p>{{else}}<div class="mezoria-bonus-panel"><strong>Racial attribute adjustments</strong>{{#if raceBonusRows.length}}<ul>{{#each raceBonusRows}}<li>{{name}} +{{points}}%</li>{{/each}}</ul>{{else}}<p>Choose the racial bonus attributes below or select a tribe, clan, or aspect.</p>{{/if}}</div>{{/if}}
   {{#if human}}
    <h4>Human Adaptability — choose exactly three different attributes (+2% each)</h4>
    <div class="mezoria-check-grid">
     {{#each humanAttributes}}<label class="mezoria-check"><input type="checkbox" data-human-attribute="{{name}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}
    </div>
    <label>Human Versatility — one free racial Skill Talent
     <select data-field="racialTalent">{{#each racialOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
   {{/if}}
   <h4>Racial Traits and Abilities</h4>
   {{#each raceTraits}}<p><strong>{{name}}</strong> — {{description}}</p>{{/each}}
  {{/if}}
  {{#if stepBackground}}
   <h3>2 · Select Background</h3>
   <label>Background <select data-field="background">{{#each backgroundOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{#if backgroundBonusPending}}<p class="mezoria-selection-hint">Choose a background to apply its bonuses.</p>{{else}}<div class="mezoria-bonus-panel"><strong>Background attribute adjustments</strong><ul>{{#each backgroundBonusRows}}<li>{{name}} +{{points}}%</li>{{/each}}</ul></div><p>Granted Skill Talent: <strong>{{backgroundTalent}}</strong></p>{{/if}}
   {{#if backgroundAbility}}<p><strong>{{backgroundAbility.name}}</strong> — {{backgroundAbility.description}} {{backgroundAbility.appliesTo}}</p>{{/if}}
   <p>Background attributes and features are applied to the sheet automatically.</p>
  {{/if}}
  {{#if stepMark}}
   <h3>3 · Select Mark of Purpose</h3>
   <label>Mark of Purpose <select data-field="mark">{{#each markOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <p>Choose two distinct Mark Talents. The Background's fixed Skill Talent takes priority on overlap.</p>{{#unless markChosen}}<p class="mezoria-selection-hint">Select a Mark of Power to reveal its available Skill Talents.</p>{{/unless}}
   {{#if markChosen}}{{#each markChoices}}<label>Mark Talent {{number}}
     <select data-talent-kind="mark" data-index="{{index}}" aria-label="Select Mark Talent">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
   </label>{{/each}}{{/if}}
  {{/if}}
  {{#if stepFree}}
   <h3>4 · Choose Three Free Skill Talents</h3>
   <p>Choose any three distinct approved skills, without duplicating a Mark, Background or racial Skill Talent.</p>
   {{#each freeChoices}}<label>Free Talent {{number}}
    <select data-talent-kind="free" data-index="{{index}}" aria-label="Select Free Talent">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
   </label>{{/each}}
  {{/if}}
  {{#if stepAttributes}}
   <h3>5 · Distribute 35 Attribute Points</h3>
   <p>Base 35% in every attribute. Spend exactly 35 points, with a maximum of +15 points (50%) in any attribute before racial and background bonuses.</p>
   <p class="mezoria-points">Points remaining: <strong>{{remaining}}</strong></p>
   {{#each attributes}}
    <label class="mezoria-attribute">{{name}}
     <input type="number" data-allocation="{{name}}" min="0" max="15" step="1" value="{{allocated}}">
     <span>{{total}}%</span>
    </label>
   {{/each}}
  {{/if}}
  {{#if stepName}}
   <h3>6 · Name Your Character</h3>
   <p>After making all character choices, select your character's name. This is the final creator step.</p>
   <label>Character name <input data-field="name" type="text" value="{{actor.name}}" placeholder="Enter character name"></label>
   {{#if valid}}
    <p class="mezoria-success">Your character is ready.</p>
    <button type="button" data-finish-creator class="mezoria-finish-button">Finish Character Creation</button>
   {{else}}
    <h4>Before you finish:</h4>{{#each errors}}<p class="mezoria-warning">{{this}}</p>{{/each}}
   {{/if}}
  {{/if}}
 </section>
 {{else}}
 <nav class="mezoria-tabs mezoria-sheet-tabs" aria-label="Character sheet tabs">
  <button type="button" data-tab="attributes" class="{{#if attrTabActive}}active{{/if}}">Attributes and Status</button>
  <button type="button" data-tab="skills" class="{{#if skillsTabActive}}active{{/if}}">Skills</button>
 </nav>
 {{#unless creationComplete}}<p class="mezoria-warning mezoria-incomplete">Character creation is not finished. Click the + button above to continue.</p>{{/unless}}
 {{#if sheetAttributes}}
 <section class="mezoria-tab-panel mezoria-attributes-panel">
  <h3>Attributes and Status</h3>
  <div class="mezoria-attributes-status-grid">
   <section class="mezoria-status-panel">
    <h4>Attributes · Saving Rolls</h4>
    <p class="mezoria-note">Base 35% + allocated points + racial and background bonuses.</p>
    <div class="mezoria-attribute-table">
     <div class="mezoria-attribute-table-head"><span>Attribute</span><span>Base</span><span>Alloc.</span><span>Race</span><span>Bg.</span><span>TN</span><span></span></div>
     {{#each attributes}}
     <div class="mezoria-attribute-save-row">
      <strong>{{name}}</strong><span>{{base}}</span><span>+{{allocated}}</span><span>+{{racial}}</span><span>+{{background}}</span><strong>{{total}}%</strong>
      <button type="button" data-roll-attr="{{name}}" aria-label="Roll {{name}} save">Roll</button>
     </div>
     {{/each}}
    </div>
   </section>
   <section class="mezoria-status-panel">
    <h4>Combat Status</h4>
    <div class="mezoria-status-summary">

     <div><span>Movement</span><strong>{{#if status.movement}}{{status.movement}} spaces{{else}}Pending{{/if}}</strong></div>
     <div><span>Dodge · Effective</span><strong>{{status.dodge}}%</strong></div>
     <div><span>Dodge · Base</span><strong>{{status.baseDodge}}%</strong></div>
     <div><span>Parry · Effective</span><strong>{{status.parry}}%</strong></div>
     <div><span>Parry · Might Base</span><strong>{{status.baseParry}}%</strong></div>
     <div><span>Block · Effective</span><strong>{{status.block}}%</strong></div>
     <div><span>Block · Endurance Base</span><strong>{{status.baseBlock}}%</strong></div>
     <div><span>Spell Resistance</span><strong>{{status.spellResistance}}%</strong></div>
     <div><span>Action Score Bonus</span><strong>+{{status.initiativeBonus}}</strong></div>
    </div>
    <label class="mezoria-wounds-control">Equipped Melee Weapon · Parry Rating
     <input type="number" min="0" step="1" data-weapon-parry-rating value="{{status.weaponParryRating}}">
    </label>
    <p class="mezoria-note">Parry = Might tens + equipped melee weapon rating. Enter the weapon rating manually until equipment items are added; multiple-weapon rules are pending. Incapacitation reduces effective Parry to 0.</p>
    <label class="mezoria-dodge-condition">
     <input type="checkbox" data-shield-equipped {{#if status.shieldEquipped}}checked{{/if}}>
     Shield equipped
    </label>
    <label class="mezoria-wounds-control">Equipped Shield · Block Rating
     <input type="number" min="0" step="1" data-shield-block-rating value="{{status.shieldBlockRating}}">
    </label>
    <p class="mezoria-note">Block = shield rating + floor(Endurance tens ÷ 2), always a whole percentage. No shield or unable to defend: Block 0. Shield item ratings and special magic-blocking properties are for equipment design.</p>
    <label class="mezoria-dodge-condition">
     <input type="checkbox" data-unable-to-evade {{#if status.unableToEvade}}checked{{/if}}>
     Unable to Dodge / Parry / Block (immobilized or otherwise physically incapable)
    </label>
    {{#if status.dodgeSuppressed}}<p class="mezoria-note">Effective Dodge, Parry, and Block are 0 while unable to defend, unconscious, or dead. Base Dodge {{status.baseDodge}}% and Might-based Parry {{status.baseParry}}% remain tracked.</p>{{/if}}
    <div class="mezoria-status-control">
     <label>Current Action Score <input type="number" step="1" data-status-field="actionScore" value="{{status.actionScore}}"></label>
     
    </div>
    <p class="mezoria-note">New round = current Action Score + d20 + Prowess tens. Action costs and spending are handled separately.</p>
   </section>
   <section class="mezoria-status-panel">
    <h4>Wounds</h4>
    <div class="mezoria-status-summary">
     <div><span>Quartz Capacity</span><strong>{{status.woundCapacity}}</strong></div>
     <div><span>Damage per Wound Threshold</span><strong>{{status.woundThreshold}}</strong></div>
    </div>
    <label class="mezoria-wounds-control">Current Wounds
     <input type="number" min="0" step="1" data-status-field="woundsTaken" value="{{status.woundsTaken}}">
    </label>
    {{#if status.bleedingToDeath}}
     <p class="mezoria-warning">Bleeding to Death — wound capacity reached.</p>
     <div class="mezoria-death-save">
      <span>Failed saves: {{status.deathSaveFailures}} / 3</span>
      <span>Next Endurance save: TN {{status.deathSaveTN}}%</span>
      <button type="button" data-death-save>Roll Endurance Save</button>
     </div>
    {{/if}}
    {{#if status.isStabilized}}
     <p class="mezoria-success">Stabilized — {{#if status.isConscious}}Conscious (LifeForce above 0){{else}}Unconscious (LifeForce 0){{/if}}</p>
    {{/if}}
    {{#if status.isDead}}<p class="mezoria-warning">Dead — three failed Endurance saves.</p>{{/if}}
    <p class="mezoria-note">Overflow creates one Wound per threshold, rounded up. An 8-hour full rest recovers 1 Wound; a 4-hour light rest recovers none. While bleeding, one successful Endurance save stabilizes; each failure gives -5% to subsequent saves, and three failures cause death. Higher-rank healing abilities may also restore Wounds.</p>
   </section>
   <section class="mezoria-status-panel">
    <h4>LifeForce and Mana</h4>
    <div class="mezoria-status-summary">
     <div><span>LifeForce · Maximum</span><strong>{{#if status.lifeForce}}{{status.lifeForce}}{{else}}Pending{{/if}}</strong></div>
     <div><span>Mana · Maximum</span><strong>{{#if status.mana}}{{status.mana}}{{else}}Pending{{/if}}</strong></div>
    </div>
    {{#if status.lifeForce}}
    <div class="mezoria-lifeforce-tracker">
     <label>Current LifeForce
      <input type="number" data-current-resource="LifeForce" min="0" max="{{status.lifeForce}}" step="1" value="{{status.currentLifeForce}}">
     </label>
     <span class="mezoria-lifeforce-maximum">/ {{status.lifeForce}}</span>
    </div>
    <div class="mezoria-lifeforce-tracker">
     <label>Current Mana
      <input type="number" data-current-resource="Mana" min="0" max="{{status.mana}}" step="1" value="{{status.currentMana}}">
     </label>
     <span class="mezoria-lifeforce-maximum">/ {{status.mana}}</span>
    </div>
    {{/if}}
    <p class="mezoria-note">Use the header buttons for End Turn, rests, and Action Score. Quartz: regenerate 1 LifeForce and 1 Mana per turn. A 4-hour light rest restores 50% of each maximum (rounded up); an 8-hour full rest restores both pools completely and heals 1 Wound. Values cannot exceed their maximum. Higher-rank bonuses and talent adjustments remain pending.</p>
    <h4>Defense and Protection</h4>
    <div class="mezoria-lifeforce-tracker">
     <label>Magical Shield · Current Mitigation
      <input type="number" data-magical-shield-mitigation min="0" step="1" value="{{status.currentMagicalShieldMitigation}}">
     </label>
     <label>Magical Shield · Remaining Duration
      <input type="text" data-magical-shield-duration maxlength="80" placeholder="Set by ability" value="{{status.magicalShieldDuration}}" {{#unless status.magicalShieldActive}}disabled{{/unless}}>
     </label>
    </div>
    <p class="mezoria-note">{{#if status.magicalShieldActive}}Magical shield active.{{else}}No active magical shield.{{/if}} The shield ends at 0 mitigation or when its ability's duration expires. Only one magical shield may be active at a time; reapplication requires a new ability use. Duration tracking is manual until effects automation is developed.</p>
    <p class="mezoria-note">Armor equipment and ability-specific shield effects will be added in their respective design sections.</p>
   </section>
  </div>
 </section>
 {{/if}}
  {{#if sheetSkills}}
 <section class="mezoria-tab-panel mezoria-skills-panel">
  <h3>Skills</h3>
  <div class="mezoria-skill-panels">
   <section class="mezoria-skill-panel mezoria-trained-skills" aria-label="Trained Skills">
    <header class="mezoria-skill-panel-title">
     <h4>Trained Skills</h4><span>{{trainedCount}} trained</span>
    </header>
    <div class="mezoria-compact-columns" aria-hidden="true">
     <span>Skill</span><span>Attr</span><span>Bonus</span><span>TN</span><span></span>
    </div>
    <div class="mezoria-skill-scroll" role="region" aria-label="Trained skill list" tabindex="0">
     {{#if trainedCount}}
      {{#each trainedSkills}}
       <div class="mezoria-compact-row mezoria-trained">
        <span class="mezoria-compact-name" title="{{name}}">{{name}}</span>
        <span title="{{attr}}">{{attrAbbr}}</span>
        <span title="{{trainedLabel}}">{{bonusLabel}}</span>
        <span class="mezoria-compact-tn">TN {{tn}}%</span>
        <button type="button" data-roll-skill="{{name}}" aria-label="Roll {{name}}">Roll</button>
       </div>
      {{/each}}
     {{else}}
      <p class="mezoria-empty-skills">No trained skills selected yet.</p>
     {{/if}}
    </div>
   </section>
   <section class="mezoria-skill-panel mezoria-untrained-skills" aria-label="Untrained Skills">
    <header class="mezoria-skill-panel-title">
     <h4>Untrained Skills</h4><span>{{untrainedCount}} available</span>
    </header>
    <nav class="mezoria-skill-attribute-tabs" aria-label="Untrained skill attributes">
     {{#each skillAttributeTabs}}
      <button type="button" data-skill-attribute="{{name}}" title="{{name}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{abbreviation}}</button>
     {{/each}}
    </nav>
    <div class="mezoria-compact-columns" aria-hidden="true">
     <span>Skill</span><span>Attr</span><span>Bonus</span><span>TN</span><span></span>
    </div>
    <div class="mezoria-skill-scroll" role="region" aria-label="{{selectedSkillAttribute}} untrained skill list" tabindex="0">
     {{#if attributeSkills.length}}
      {{#each attributeSkills}}
       <div class="mezoria-compact-row">
        <span class="mezoria-compact-name" title="{{name}}">{{name}}</span>
        <span title="{{attr}}">{{attrAbbr}}</span>
        <span>{{bonusLabel}}</span>
        <span class="mezoria-compact-tn">TN {{tn}}%</span>
        <button type="button" data-roll-skill="{{name}}" aria-label="Roll {{name}}">Roll</button>
       </div>
      {{/each}}
     {{else}}
      <p class="mezoria-empty-skills">No untrained-usable skills for {{selectedSkillAttribute}}.</p>
     {{/if}}
    </div>
   </section>
  </div>
 </section>
 {{/if}}
 {{/if}}
 {{/if}}
</form>