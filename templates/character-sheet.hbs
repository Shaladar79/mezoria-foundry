<form class="mezoria-creation" autocomplete="off">
 {{#if error}}
  <p class="mezoria-warning">{{error}}</p>
 {{else}}
 <header class="mezoria-header">
  <div class="mezoria-headline">
   <div><h2>MEZORIA · Character</h2><p>Rank 1 · Quartz</p></div>
   {{#if creatorOpen}}
    <button type="button" class="mezoria-back-button" data-close-creator>Back to Sheet</button>
   {{else}}
    <button type="button" class="mezoria-create-button" data-open-creator title="Open Character Creator" aria-label="Open Character Creator">+</button>
   {{/if}}
  </div>
  <div class="mezoria-identity">
   <label>Name <input type="text" value="{{headerName}}" readonly></label>
   <label>Race <input type="text" value="{{headerRace}}" readonly></label>
   {{#if showSubgroup}}<label>{{subgroupType}} <input type="text" value="{{headerSubgroup}}" readonly></label>{{/if}}
   <label>Background <input type="text" value="{{headerBackground}}" readonly></label>
   <label>Mark <input type="text" value="{{headerMark}}" readonly></label>
  </div>
 </header>

 {{#if creatorOpen}}
 <nav class="mezoria-tabs mezoria-creation-tabs" aria-label="Character creation steps">
  {{#each steps}}<button type="button" data-step="{{key}}" class="{{#if active}}active{{/if}}">{{title}}</button>{{/each}}
 </nav>
 <section class="mezoria-wizard">
  {{#if stepRace}}
   <h3>1 · Select Race</h3>
   <label>Race <select data-field="race">{{#each raceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{#if showSubgroup}}
    <label>{{subgroupType}} <select data-field="subgroup"><option value="">Choose…</option>{{#each subgroupOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{/if}}
   {{#if raceBonusPending}}<p class="mezoria-selection-hint">Choose a race to apply its attribute adjustments.</p>{{else}}<div class="mezoria-bonus-panel"><strong>Racial attribute adjustments</strong>{{#if raceBonusRows.length}}<ul>{{#each raceBonusRows}}<li>{{name}} +{{points}}%</li>{{/each}}</ul>{{else}}<p>Choose the racial bonus attributes below or select a tribe, clan, or aspect.</p>{{/if}}</div>{{/if}}
   {{#if human}}
    <h4>Human Adaptability — choose exactly three different attributes (+2% each)</h4>
    <div class="mezoria-check-grid">
     {{#each humanAttributes}}<label class="mezoria-check"><input type="checkbox" data-human-attribute="{{name}}" {{#if checked}}checked{{/if}}> {{name}}</label>{{/each}}
    </div>
    <label>Human Versatility — one free racial Skill Talent
     <select data-field="racialTalent">{{#each racialOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
   {{/if}}
   <h4>Racial Traits and Abilities</h4>
   {{#each raceTraits}}<p><strong>{{name}}</strong> — {{description}}</p>{{/each}}
  {{/if}}
  {{#if stepBackground}}
   <h3>2 · Select Background</h3>
   <label>Background <select data-field="background">{{#each backgroundOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   {{#if backgroundBonusPending}}<p class="mezoria-selection-hint">Choose a background to apply its bonuses.</p>{{else}}<div class="mezoria-bonus-panel"><strong>Background attribute adjustments</strong><ul>{{#each backgroundBonusRows}}<li>{{name}} +{{points}}%</li>{{/each}}</ul></div><p>Granted Skill Talent: <strong>{{backgroundTalent}}</strong></p>{{/if}}
   {{#if backgroundAbility}}<p><strong>{{backgroundAbility.name}}</strong> — {{backgroundAbility.description}} {{backgroundAbility.appliesTo}}</p>{{/if}}
   <p>Background attributes and features are applied to the sheet automatically.</p>
  {{/if}}
  {{#if stepMark}}
   <h3>3 · Select Mark of Power</h3>
   <label>Mark <select data-field="mark">{{#each markOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
   <p>Choose two distinct Mark Talents. The Background's fixed Skill Talent takes priority on overlap.</p>{{#unless markChosen}}<p class="mezoria-selection-hint">Select a Mark of Power to reveal its available Skill Talents.</p>{{/unless}}
   {{#if markChosen}}{{#each markChoices}}<label>Mark Talent {{number}}
     <select data-talent-kind="mark" data-index="{{index}}" aria-label="Select Mark Talent">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
   </label>{{/each}}{{/if}}
  {{/if}}
  {{#if stepFree}}
   <h3>4 · Choose Three Free Skill Talents</h3>
   <p>Choose any three distinct approved skills, without duplicating a Mark, Background or racial Skill Talent.</p>
   {{#each freeChoices}}<label>Free Talent {{number}}
    <select data-talent-kind="free" data-index="{{index}}" aria-label="Select Free Talent">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
   </label>{{/each}}
  {{/if}}
  {{#if stepAttributes}}
   <h3>5 · Distribute 35 Attribute Points</h3>
   <p>Base 35% in every attribute. Spend exactly 35 points, with a maximum of +15 points (50%) in any attribute before racial and background bonuses.</p>
   <p class="mezoria-points">Points remaining: <strong>{{remaining}}</strong></p>
   {{#each attributes}}
    <label class="mezoria-attribute">{{name}}
     <input type="number" data-allocation="{{name}}" min="0" max="15" step="1" value="{{allocated}}">
     <span>{{total}}%</span>
    </label>
   {{/each}}
  {{/if}}
  {{#if stepName}}
   <h3>6 · Name Your Character</h3>
   <p>After making all character choices, select your character's name. This is the final creator step.</p>
   <label>Character name <input data-field="name" type="text" value="{{actor.name}}" placeholder="Enter character name"></label>
   {{#if valid}}
    <p class="mezoria-success">Your character is ready.</p>
    <button type="button" data-finish-creator class="mezoria-finish-button">Finish Character Creation</button>
   {{else}}
    <h4>Before you finish:</h4>{{#each errors}}<p class="mezoria-warning">{{this}}</p>{{/each}}
   {{/if}}
  {{/if}}
 </section>
 {{else}}
 <nav class="mezoria-tabs mezoria-sheet-tabs" aria-label="Character sheet tabs">
  <button type="button" data-tab="attributes" class="{{#if attrTabActive}}active{{/if}}">Attributes and Status</button>
  <button type="button" data-tab="skills" class="{{#if skillsTabActive}}active{{/if}}">Skills</button>
 </nav>
 {{#unless creationComplete}}<p class="mezoria-warning mezoria-incomplete">Character creation is not finished. Click the + button above to continue.</p>{{/unless}}
 {{#if sheetAttributes}}
 <section class="mezoria-tab-panel">
  <h3>Attributes and Status</h3>
  <p>Attribute saves roll d100 against the attribute's current percentage.</p>
  <div class="mezoria-roll-list">
   {{#each attributes}}
   <div class="mezoria-roll-row">
    <strong>{{name}}</strong><span class="mezoria-target" title="Current attribute save target number">TN {{total}}%</span>
    <button type="button" data-roll-attr="{{name}}" aria-label="Roll {{name}} save">Roll</button>
   </div>
   {{/each}}
  </div>
  <h3>Status</h3>
  <div class="mezoria-status-grid">
   <div><span>Health</span><strong>Pending</strong></div>
   <div><span>Mana</span><strong>Pending</strong></div>
   <div><span>Wounds</span><strong>Pending</strong></div>
   <div><span>Defenses</span><strong>Pending</strong></div>
   <div><span>Movement</span><strong>{{#if derived.movement}}{{derived.movement}} spaces{{else}}Pending{{/if}}</strong></div>
   <div><span>Rank</span><strong>1 · Quartz</strong></div>
  </div>
  <p class="mezoria-note">Health, Mana, Wounds, and Defense formulas will be connected when their rules are finalized.</p>
 </section>
 {{/if}}
 {{#if sheetSkills}}
 <section class="mezoria-tab-panel mezoria-skills-panel">
  <h3>Skills</h3>
  <section class="mezoria-trained-skills" aria-label="Trained skills">
   <div class="mezoria-skill-section-heading">
    <h4>Trained Skills</h4><span>{{trainedCount}} trained</span>
   </div>
   {{#if trainedCount}}
   <div class="mezoria-roll-list">
    {{#each trainedSkills}}
    <div class="mezoria-roll-row mezoria-skill-row mezoria-trained">
     <div class="mezoria-skill-name"><strong>{{name}}</strong><small>{{attr}} · {{trainedLabel}}</small></div>
     <span class="mezoria-target" title="Skill target number, including training bonus">TN {{tn}}%</span>
     <button type="button" data-roll-skill="{{name}}" aria-label="Roll {{name}}">Roll</button>
    </div>
    {{/each}}
   </div>
   {{else}}<p class="mezoria-empty-skills">No trained skills selected yet. Complete character creation to add them.</p>{{/if}}
  </section>
  <section class="mezoria-untrained-skills" aria-label="Skills usable untrained">
   <div class="mezoria-skill-section-heading">
    <h4>Skills Usable Untrained</h4><span>{{untrainedCount}} available</span>
   </div>
   <nav class="mezoria-skill-attribute-tabs" aria-label="Skill governing attribute">
    {{#each skillAttributeTabs}}
     <button type="button" data-skill-attribute="{{name}}" class="{{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
      {{name}} <span class="mezoria-skill-count">({{count}})</span>
     </button>
    {{/each}}
   </nav>
   <h5>{{selectedSkillAttribute}} Skills</h5>
   {{#if attributeSkills.length}}
    <div class="mezoria-roll-list">
     {{#each attributeSkills}}
     <div class="mezoria-roll-row mezoria-skill-row">
      <div class="mezoria-skill-name"><strong>{{name}}</strong><small>{{attr}} · {{trainedLabel}}</small></div>
      <span class="mezoria-target" title="Untrained skill target number">TN {{tn}}%</span>
      <button type="button" data-roll-skill="{{name}}" aria-label="Roll {{name}}">Roll</button>
     </div>
     {{/each}}
    </div>
   {{else}}<p class="mezoria-empty-skills">No untrained-usable skills under {{selectedSkillAttribute}}.</p>{{/if}}
  </section>
 </section>
 {{/if}}
 {{/if}}
 {{/if}}
</form>